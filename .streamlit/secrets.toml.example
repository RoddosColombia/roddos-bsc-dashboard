# Copia este archivo como secrets.toml (en esta misma carpeta) y completa los valores.
# secrets.toml NO se sube al repo: está en .gitignore.

[acceso]
clave_directores = "cambia-esto"

[historico]
destino = "local"   # "mongo" solo en el servidor publicado

# Respaldo en MongoDB: déjalo comentado en tu computador.
# Si lo activas, los Excel que subas reemplazan los de producción.
# [mongo]
# uri = "PEGA_AQUI_LA_URI"
# db = "bsc_dashboard"

# Lectura automática desde SharePoint (ver sharepoint.py). Solo lectura.
# Los datos los entrega quien registre la aplicación en Microsoft Entra ID.
# [sharepoint]
# activo = true
# tenant_id = "Directory (tenant) ID"
# client_id = "Application (client) ID"
# client_secret = "valor del secreto — NUNCA en el repositorio"
# sitio = "roddossas.sharepoint.com:/sites/RODDOSSAS"
# carpeta = "RODDOS/8. DASHBOARD BSC RODDOS/1 Fuentes al día"
# intervalo_minutos = 10
# espera_minutos = 5
#
# Archivos que viven en OTRA carpeta (ruta dentro de Documentos). El inventario maestro
# está en Operaciones; la copia de la carpeta del dashboard se queda desactualizada.
# [sharepoint.archivos]
# inventario = "RODDOS/2. OPERACIONES/MOTOS/Inventario 2026.xlsx"
